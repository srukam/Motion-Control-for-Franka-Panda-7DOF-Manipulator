<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>panda_arm_control_ros2</name>
  <version>0.1.0</version>
  <description>
    ROS 2 port of panda_arm_control. Provides Cartesian/joint behaviors for
    Franka Emika Panda (7-DOF) and Universal Robots UR5 (6-DOF) on top of the
    standard MoveIt 2 interfaces (no moveit_py / pymoveit2 dependency).
  </description>
  <maintainer email="automatolabs@gmail.com">automatolabs</maintainer>
  <license>TODO</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>pymoveit2</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>trajectory_msgs</exec_depend>
  <exec_depend>moveit_msgs</exec_depend>
  <exec_depend>shape_msgs</exec_depend>
  <exec_depend>action_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>

  <!-- Real-execution stacks (UR5) -->
  <exec_depend>ur_robot_driver</exec_depend>
  <exec_depend>ur_description</exec_depend>
  <exec_depend>ur_moveit_config</exec_depend>
  <exec_depend>ur_calibration</exec_depend>

  <!-- Demo / offline test (Panda) -->
  <exec_depend>moveit_resources_panda_moveit_config</exec_depend>

  <!-- Generic MoveIt 2 runtime pieces used by either robot -->
  <exec_depend>moveit_ros_move_group</exec_depend>
  <exec_depend>moveit_ros_planning</exec_depend>
  <exec_depend>moveit_ros_planning_interface</exec_depend>
  <exec_depend>moveit_planners_ompl</exec_depend>
  <exec_depend>moveit_simple_controller_manager</exec_depend>
  <exec_depend>moveit_kinematics</exec_depend>

  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
